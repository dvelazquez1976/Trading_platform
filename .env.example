# Copia este archivo a .env y rellena tus claves.
# .env está en .gitignore — NUNCA lo versiones.

# Alpha Vantage (gratuito con límites, o pago)
# ALPHA_VANTAGE_API_KEY=tu_clave_aqui

# Polygon.io (requiere suscripción de pago)
# POLYGON_API_KEY=tu_clave_aqui

# Tiingo (plan gratuito disponible)
# TIINGO_API_KEY=tu_clave_aqui
